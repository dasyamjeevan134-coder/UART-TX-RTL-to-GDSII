library (uart_tx) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1A";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 25.0;
  nom_voltage                    : 1.80;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1 ("0.00050,  0.00159,  0.00506,  0.01608,  0.05115,  0.16265,  0.51728");
  }
  type ("data") {
    base_type : array;
    data_type : bit;
    bit_width : 8;
    bit_from : 7;
    bit_to : 0;
  }

  cell ("uart_tx") {
    pin("busy") {
      direction : output;
      capacitance : 0.0000;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("0.69775,0.70211,0.71339,0.74085,0.81391,1.03821,1.74870");
	}
	rise_transition(template_1) {
          values("0.02222,0.02550,0.03526,0.06459,0.16174,0.48310,1.50728");
	}
	cell_fall(template_1) {
          values("0.74567,0.74958,0.75969,0.78285,0.83705,0.98921,1.46876");
	}
	fall_transition(template_1) {
          values("0.02064,0.02328,0.03049,0.04999,0.10916,0.30683,0.95172");
	}
      }
    }
    pin("clk") {
      direction : input;
      capacitance : 0.0079;
    }
    pin("reset") {
      direction : input;
      capacitance : 0.0030;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	fall_constraint(scalar) {
          values("0.39978");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	fall_constraint(scalar) {
          values("-0.01438");
	}
      }
    }
    pin("start") {
      direction : input;
      capacitance : 0.0035;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.08618");
	}
	fall_constraint(scalar) {
          values("-0.03089");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.45772");
	}
	fall_constraint(scalar) {
          values("0.62454");
	}
      }
    }
    pin("tx") {
      direction : output;
      capacitance : 0.0000;
      timing() {
        related_pin : "clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          values("0.99980,1.00413,1.01538,1.04282,1.11589,1.33996,2.04972");
	}
	rise_transition(template_1) {
          values("0.02226,0.02554,0.03530,0.06461,0.16185,0.48281,1.50670");
	}
	cell_fall(template_1) {
          values("0.83074,0.83465,0.84476,0.86791,0.92209,1.07430,1.55402");
	}
	fall_transition(template_1) {
          values("0.02066,0.02330,0.03049,0.04996,0.10913,0.30679,0.95042");
	}
      }
    }
    pin("VPWR") {
      direction : input;
      capacitance : 0.0000;
    }
    pin("VGND") {
      direction : input;
      capacitance : 0.0000;
    }
    bus("data") {
      bus_type : data;
      direction : input;
      capacitance : 0.0000;
    pin("data[7]") {
      direction : input;
      capacitance : 0.0032;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.01889");
	}
	fall_constraint(scalar) {
          values("-0.18194");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.04474");
	}
	fall_constraint(scalar) {
          values("0.25015");
	}
      }
    }
    pin("data[6]") {
      direction : input;
