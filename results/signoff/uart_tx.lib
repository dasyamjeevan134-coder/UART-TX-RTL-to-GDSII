	rise_constraint(scalar) {
          values("0.05340");
	}
	fall_constraint(scalar) {
          values("0.25145");
	}
      }
    }
    pin("data[2]") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.02045");
	}
	fall_constraint(scalar) {
          values("-0.18027");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.04631");
	}
	fall_constraint(scalar) {
