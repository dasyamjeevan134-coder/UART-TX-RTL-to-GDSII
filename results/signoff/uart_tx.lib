	rise_constraint(scalar) {
          values("0.05354");
	}
	fall_constraint(scalar) {
          values("0.25254");
	}
      }
    }
    pin("data[4]") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.02705");
	}
	fall_constraint(scalar) {
          values("-0.18615");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.05309");
	}
	fall_constraint(scalar) {
          values("0.25450");
	}
      }
    }
    pin("data[3]") {
      direction : input;
      capacitance : 0.0062;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.02758");
	}
	fall_constraint(scalar) {
          values("-0.18323");
	}
      }
      timing() {
        related_pin : "clk";
