	}
      }
    }
    pin("data[0]") {
      direction : input;
      capacitance : 0.0034;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.02140");
	}
	fall_constraint(scalar) {
          values("-0.18317");
	}
      }
      timing() {
        related_pin : "clk";
