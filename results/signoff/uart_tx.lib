        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.04993");
	}
	fall_constraint(scalar) {
          values("-0.20154");
	}
      }
      timing() {
        related_pin : "clk";
        timing_type : setup_rising;
	rise_constraint(scalar) {
          values("0.07597");
	}
	fall_constraint(scalar) {
          values("0.26989");
	}
      }
    }
    pin("data[5]") {
      direction : input;
      capacitance : 0.0059;
      timing() {
        related_pin : "clk";
        timing_type : hold_rising;
	rise_constraint(scalar) {
          values("-0.02772");
	}
	fall_constraint(scalar) {
